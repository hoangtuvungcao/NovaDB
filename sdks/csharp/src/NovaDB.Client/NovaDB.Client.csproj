<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 is supported by Unity 2021.2+ and every modern .NET runtime. -->
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>NovaDB.Client</RootNamespace>
    <AssemblyName>NovaDB.Client</AssemblyName>
    <PackageId>NovaDB.Client</PackageId>
    <Version>0.2.0</Version>
    <Description>Official NovaDB HTTP client for .NET and Unity. No third-party dependencies.</Description>
    <PackageTags>novadb;sqlite;database;unity;client</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NovaDB.Client.Tests" />
  </ItemGroup>

</Project>
